# Copie para .env e preencha. NÃO versione o .env.

# Postgres do Supabase (Settings > Database > Connection string > URI).
# Porta 5432 (direct/session pooler) para carga em lote.
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# Chave publishable (anon) — usada só pra referência aqui; o front usa web/.env.
SUPABASE_API_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# REST / Storage — necessário só para scraper/fotos_upload.py (sobe as fotos).
# SUPABASE_SERVICE_KEY é a chave SECRETA (Settings > API > service_role / secret).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
